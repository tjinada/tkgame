          "consequenceHint": "Likely: +Affinity"
        },
        {
          "archetype": "OBSERVE",
          "text": "Wait silently, gauge the situation",
          "label": "Observe",
          "consequenceHint": "Neutral"
        },
        {
          "archetype": "NEGOTIATE",
          "text": "Ask what is expected of you",
          "label": "Seek Guidance",
          "rollRequired": { "dc": 10, "stat": "obedience" },
          "consequenceHint": "Shows initiative"
        }
      ]
    },
