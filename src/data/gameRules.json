  "maskingRules": {
    "description": "Slave attempts to hide reactions from Mistresses",
    "baseDC": 15,
    "enduranceCost": 5,
    "modifiers": {
      "highVulnerability": { "threshold": 70, "dcBonus": 3, "description": "Hard to hide extreme sensitivity" },
      "lowEndurance": { "threshold": 30, "dcBonus": 2, "description": "Too exhausted to maintain composure" },
      "masteredKnowledge": { "dcBonus": 5, "description": "She knows you too well" },
      "bondage": { "dcBonus": 2, "description": "Can't squirm away while restrained" }
    },
    "successEffect": {
      "discoveryPrevented": true,
      "enduranceLoss": 5,
      "narrative": "You manage to suppress your reaction, but it costs you."
    },
    "failureEffect": {
      "discoveryBonus": 10,
      "enduranceLoss": 3,
      "narrative": "Your attempt to hide it only makes it more obvious."
    }
  },
  
  "counterDiscoveryRules": {
    "description": "Slave learning about Mistress weaknesses",
    "enabled": true,
    "discoveryChance": 0.1,
    "discoveryConditions": [
